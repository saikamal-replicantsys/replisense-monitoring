[
  {
    "uid": "replisense-qc-collector",
    "title": "QC required services / collector unavailable",
    "folderUID": "replisense-qc",
    "ruleGroup": "qc-operations",
    "orgID": 1,
    "condition": "C",
    "for": "3m",
    "noDataState": "Alerting",
    "execErrState": "Alerting",
    "isPaused": false,
    "data": [
      {
        "refId": "A",
        "datasourceUid": "grafanacloud-prom",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "model": {
          "refId": "A",
          "expr": "sum(up{environment=\"qc\",job=~\"replisense-(node-api|qc-worker|python-gateway)\"}) or vector(0)",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "editorMode": "code",
          "intervalMs": 60000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "conditions": []
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "type": "query",
              "evaluator": {
                "type": "lt",
                "params": [
                  3
                ]
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "C"
                ]
              },
              "reducer": {
                "type": "last",
                "params": []
              }
            }
          ]
        }
      }
    ],
    "labels": {
      "environment": "qc",
      "application": "replisense",
      "observability": "replisense-qc",
      "severity": "critical"
    },
    "annotations": {
      "summary": "QC required services / collector unavailable",
      "description": "Missing/private service metrics or loss of the QC collector. Check EC2/SSM and container health.",
      "runbook_url": "https://neatparlor1816.grafana.net/d/replisense-qc-operations"
    }
  },
